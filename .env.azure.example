# Copy to .env.azure on the VM and run: chmod 600 .env.azure
# Keep the password URL-safe, or percent-encode it inside DATABASE_URL.

POSTGRES_USER=dive
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD
POSTGRES_DB=dive2026
POSTGIS_IMAGE=postgis/postgis:16-3.4
DB_PORT=5433

DATABASE_URL=postgresql+asyncpg://dive:REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD@db:5432/dive2026
DATABASE_SSL=false

API_IMAGE=dive2026-api:azure
SEED_IMAGE=dive2026-seed:azure
API_WORKERS=2
API_BIND_IP=0.0.0.0
API_PORT=3000

# Optional HTTPS stack. API_UPSTREAM connects the separate Nginx Compose
# project to the API's existing host port.
API_DOMAIN=dive20261-api.koreacentral.cloudapp.azure.com
API_UPSTREAM=host.docker.internal:3000
CERTBOT_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443
NGINX_IMAGE=nginx:stable-alpine
CERTBOT_IMAGE=certbot/certbot:latest

ENVIRONMENT=production
APP_VERSION=0.1.0

# Comma-separated exact browser origins. Do not use "*" with credentialed requests.
FRONTEND_ORIGINS=https://YOUR_FRONTEND_DOMAIN
FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN

# REST key used by the one-shot geocode container.
KAKAO_REST_API_KEY=

# Gemini key used by POST /api/ai/search.
GEMINI_API_KEY=
