DATABASE_URL=postgresql+asyncpg://dive:dive@localhost:5433/dive2026
ENVIRONMENT=local

# REST API key from https://developers.kakao.com/console/app — NOT the JS SDK
# key (that one goes in client/.env as VITE_KAKAO_MAP_KEY). Same Kakao app,
# two different keys with different permission scopes.
KAKAO_REST_API_KEY=

# Gemini API key from https://aistudio.google.com/apikey — powers the AI
# search assistant (POST /api/ai/search). Without it, that endpoint returns
# a clear "not configured" error instead of crashing.
GEMINI_API_KEY=
